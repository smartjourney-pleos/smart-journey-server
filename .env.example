# 복사해서 .env 로 저장하면 bootRun 시 자동으로 읽힘 (.env 는 커밋 금지)
# cp .env.example .env

# postgres 프로필에서만 사용
DB_URL=jdbc:postgresql://localhost:5432/smartjourney
DB_USERNAME=smartjourney
DB_PASSWORD=change-me

# 32바이트 이상 임의 문자열 (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
QR_SECRET=change-me-to-another-long-random-string-32-bytes

# 카카오모빌리티 REST 키 (P1 코스 최적화에서만 사용, 없으면 사용자가 고른 순서 그대로)
KAKAO_REST_API_KEY=
