# 복사해서 .env 로 저장하면 bootRun 시 자동으로 읽힘 (.env 는 커밋 금지)
# cp .env.example .env
# 서버(VM)에서는 /opt/smartjourney/.env 에 두면 systemd 와 Spring 이 같이 읽는다

# ---- postgres 프로필에서만 사용 ----
DB_URL=jdbc:postgresql://localhost:5432/smartjourney
DB_USERNAME=smartjourney
DB_PASSWORD=change-me

# ---- 비밀값: 32바이트 이상 임의 문자열 (openssl rand -base64 48) ----
# postgres 프로필은 기본값(local-dev-only…)이면 부팅을 거부한다
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
QR_SECRET=change-me-to-another-long-random-string-32-bytes

# ---- 운영 지표 API·대시보드 (/ops/kpi.html) 토큰. 비우면 KPI API 꺼짐 ----
OPS_TOKEN=

# ---- 코스 순서 제안 (P1-2) ----
# none = 사용자가 고른 순서 그대로 / kakao = 카카오모빌리티 소요시간으로 최적화
ROUTE_PROVIDER=none
# 카카오 디벨로퍼스 REST API 키 (서버에만 둔다. 앱에 넣지 않음)
KAKAO_REST_API_KEY=

# ---- 배포 ----
# POS 웹 도메인 (쉼표로 여러 개). WebSocket Origin 검사에도 쓰인다
ALLOWED_ORIGINS=http://localhost:*
# 2차 PT·전시 기간엔 true (POS 데모 패널), 실제 매장 운영은 false
DEMO_ENABLED=true
# 리버스 프록시(Caddy/Nginx) 뒤에서는 127.0.0.1 로 묶어 8080 을 바깥에 열지 않는다
# SERVER_ADDRESS=127.0.0.1
