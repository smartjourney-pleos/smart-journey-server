# /etc/systemd/system/smartjourney.service
# 설치:  sudo cp deploy/smartjourney.service /etc/systemd/system/
#        sudo systemctl daemon-reload && sudo systemctl enable --now smartjourney
# 로그:  journalctl -u smartjourney -f      (토큰·PIN 은 로그에서 가려진다)

[Unit]
Description=Smart Journey server (Spring Boot)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=smartjourney
Group=smartjourney
WorkingDirectory=/opt/smartjourney
EnvironmentFile=/opt/smartjourney/.env
Environment=SPRING_PROFILES_ACTIVE=postgres
Environment=SERVER_ADDRESS=127.0.0.1
ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Seoul -jar /opt/smartjourney/app.jar
# SIGTERM 으로 끝나면(graceful shutdown) 정상 종료로 본다
SuccessExitStatus=143
Restart=always
RestartSec=5
TimeoutStopSec=30

# 최소 권한
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smartjourney

[Install]
WantedBy=multi-user.target
